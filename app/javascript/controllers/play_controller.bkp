import { Controller } from "@hotwired/stimulus"


// Connects to data-controller="play"
export default class extends Controller {

	connect() {
		console.log("Play Buttons Controller Connected");
	}

    vsbot(e) {
        e.preventDefault();
        console.log("Opa la Loca")
        window.location.href = "/game/vsbot.html?event=vsbot";
    }

    online(e) {
        e.preventDefault();
        window.location.href = "/game/online.html?event=online";
    }

    design(e) {
        e.preventDefault();
        window.location.href = "/game/design.html?event=design";
    }
}

