<h2 class="text-center pt-5"><%= t('.change_your_password', :default => 'Change your password') %></h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="d-flex flex-column justify-content-center align-items-center">

    <div class="form-group mb-3 col-6 col-md-4">
      <%= f.label :password, t('.new_password', :default => 'New password') %>, class:"form-label" %>
      <% if @minimum_password_length %>
        <em>(<%= @minimum_password_length %> characters minimum)</em>
      <% end %>
      <%= f.password_field :password, autofocus: true, autocomplete: t('.new_password', :default => 'New password'), class:"form-control"  %>
    </div>

    <div class="form-group mb-3 col-6 col-md-4">
      <%= f.label :password_confirmation, t('.confirm_new_password', :default => 'Confirm new password') %>, class:"form-label" %>
      <%= f.password_field :password_confirmation, autocomplete: t('.new_password', :default => 'New password'), class:"form-control"  %>
    </div>

    <div class="mb-3 d-flex align-items-center justify-content-center">
      <%= f.submit t('.change_my_password', :default => 'Change my password'), class:"btn btn-lg btn-primary rounded-pill" %>
    </div>

    <%= render "devise/shared/links" %>
  </div>
<% end %>

