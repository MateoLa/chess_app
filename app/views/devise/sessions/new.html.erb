<div class="mx-auto w-100 w-md-50 bg-light p-4 rounded">
    <h3 class="mb-3"><%= t(:sign_in) %></h3>

    <%= form_for resource, as: resource_name, url: session_path(resource_name), class: "contents" do |f| %>
        <div class="mb-3">
            <%= f.email_field :email, id: "user_email", required: true, autofocus: true, autocomplete: "email", placeholder: t(:email), class:"form-control" %>
        </div>

        <div class="mb-3">
            <%= f.password_field :password, required: true, autocomplete: "current-password", placeholder: t(:password), class:"form-control" %>
        </div>

        <% if devise_mapping.rememberable? %>
            <div class="form-check mb-3 col-6 col-md-4">
                <%= f.check_box :remember_me, class:"form-check-input" %>
                <%= f.label :remember_me, t(:remember_me), class:"form-check-label" %>
            </div>
        <% end %>

        <div class="mb-3">
            <%= f.submit t(:sign_in), class:"btn btn-primary rounded" %>
        </div>

        <%= render "devise/shared/links" %>
    <% end %>
</div>
