<div id="bot-form" class="my-3 p-3 text-bg-<%= @theme %>">
    <div class="d-flex align-items-center my-2">
        <%= image_tag("svg/robot.svg", class: "rounded-circle", width: 18, height: 18) %>
        <div class="ms-3"><%= t(:play_vs_bot) %></div>
    </div>

    <%= form_with model: Game.new, url: vsbot_game_path, data: { turbo: false } do |form| %>
        <div class="my-2 row">
            <div class="col-12 col-md-3 align-self-center">
                <span><%= t(:mode) %></span>
            </div>
            <div class="col-12 col-md-9">
                <%= form.select :mode, mode_select_options, {selected: @mode}, {
                    id: "bot-mode",
                    class: "w-100 custom-font-size text-bg-#{@theme}",
                    aria: {label: "vs Bot Mode"} 
                } %>
            </div>
        </div>

        <div class="my-2 row">
            <div class="col-12 col-md-3 align-self-center">
                <span><%= t(:speed) %></span>
            </div>
            <div class="col-12 col-md-9">
                <%= form.select :variant_id, variant_select_options.join.html_safe, {selected: @variant.id}, {
                    id: "bot-variant", 
                    class: "w-100 custom-font-size text-bg-#{@theme}",
                    aria: { label: 'vs Bot Variant' }, 
                    data: { challenge_tx_target: "variant" }
                } %>
            </div>
        </div>

        <div class="my-2 row">
            <div class="col-12 col-md-3 align-self-center">
                <span><%= t(:level) %></span>
            </div>
            <div class="col-12 col-md-9">
                <%= form.select :level, level_select_options, {selected: @level}, { 
                    aria: { label: 'vs Bot Level' }, 
                    class: "w-100 text-start custom-font-size text-bg-#{@theme}"
                } %>
            </div>
        </div>

        <div class="my-2 row">
            <div class="col-12 col-md-3 align-self-center">
                <span><%= t(:color) %></span>
            </div>
            <div class="col-12 col-md-9">
                <div class="form-check-inline p-1 m-0 me-2">
                    <%= form.radio_button :color, "white", checked: true %>
                    <%= form.label :color_white, t(:white) %>
                </div>
                <div class="form-check-inline p-1 m-0">
                    <%= form.radio_button :color, "black" %>
                    <%= form.label :color_black, t(:black) %>
                </div>
            </div>
        </div>

        <div class="mt-3 text-center">
            <%= form.submit t(:play), class: "w-50 btn btn-outline-success custom-font-size" %>
        </div>
    <% end %>
</div>
