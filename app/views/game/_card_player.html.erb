<div id="player-card" class="d-flex align-items-center my-2 pe-3">
	<% if player %>
		<%= image_tag player.avatar.variant(:inline) %>
		<%= content_tag :div, player.username, id: "player-name", class: "mx-2" %>
	<% else %>
		<%= image_tag "png/question-mark.png", size: "50x50" %>
		<%= content_tag :div, t(:guest), class: "mx-2" %>
	<% end %>

	<% timer = @color == "white" ? "btimer" : "wtimer" %>
	<div id="player-timer" class="ms-auto" data-game-target="<%= timer %>"></div>
</div>


