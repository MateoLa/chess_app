<div id="game" class="row">
    <div class="col-md-7 order-md-2 text-center pt-3">
        <%= content_tag :div, id: "game", data: {
            controller: "no-name-controller",
            token: @token,
			orientation: @color,
    		game_id: @game&.id,
            mode: @mode,
        	turn: "w",
        	white_timer: @variant.timer,
        	black_timer: @variant.timer,
    	    increment: @variant.time_increment,
    	    updated_at: @game&.updated_at.to_f,
            board_theme: @board_theme,
            piece_theme: pieceTheme(@piece_theme),
        } do %>
            <div><%= t(:online_game) %></div>

            <div class="my-2 mx-auto w-100" style="max-width: 500px;">
                <%= render "game/card_opponent", color: @color, against: opponent(@color, @game) %>
                <div id="board" class="w-100 mx-auto" style="max-width: 500px;"></div>
                <%= render "game/card_current", color: @color %>
				<%= render "game/promotion" %>
            </div>

            <%= render "game/navigator", controller: "notable", pause: true %>

            <div class="my-3">
                <h5><%= t(:annotation) %></h5>
                <p data-notable-target="evaluation"></p>
            </div>

            <div class="my-3">
                <h5><%= t(:state) %></h5>
                <p data-game-target="state"></p>
            </div>
        <% end %>
    </div>

    <div class="col-md-3 order-md-1 d-flex flex-column vh-75 custom-font-size">
        <p class="my-3">There are <strong><%= pluralize(@online_users, "User") %></strong> Online.</p>
        <%= render template: "games/arena" %>
    </div>

    <div class="col-md-2 order-md-3">
        <%= render "game/game_settings" %>
    </div>
</div>
