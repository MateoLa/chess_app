<div id="bot-card" class="d-flex align-items-center my-2 pe-3">
	<%= image_tag bots.sample, size: "50x50" %>
	<%= content_tag :div, t(:computer), class: "mx-2" %>

	<% timer = @color == "white" ? "btimer" : "wtimer" %>
	<div id="bot-timer" class="ms-auto" data-game-target="<%= timer %>"></div>
</div>


