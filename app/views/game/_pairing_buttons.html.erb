<div id="pairing-buttons" class="my-3 p-3 text-bg-<%= @theme %>">
    <div class="d-flex align-items-center my-2">
        <%= image_tag("svg/person2.svg", class: "rounded-circle", width: 18, height: 18) %>
        <div class="ms-3"><%= t(:play_online) %></div>
    </div>

    <div data-controller="pairing">
        <div class="my-2 row">
            <div class="col-12 col-md-3 align-self-center">
                <span><%= t(:mode) %></span>
            </div>
            <div class="col-12 col-md-9">
                <%= select_tag :mode, options_for_select(mode_select_options, @mode), {
                    id: "pairing-mode",
                    class: "w-100 custom-font-size text-bg-#{@theme}",
                    aria: { label: "Pairing Mode" },
                    data: { pairing_target: "mode" }
                } %>
            </div>
        </div>

        <div class="my-2 row">
            <div class="col-12 col-md-3 align-self-center">
                <span><%= t(:speed) %></span>
            </div>
            <div class="col-12 col-md-9">
                <%= select_tag :variant_id, options_for_select(variant_select_options.join.html_safe, @variant.id), {
                    id: "pairing-variant", 
                    class: "w-100 custom-font-size text-bg-#{@theme}",
                    aria: { label: 'Arena Variant' }, 
                    data: { pairing_target: "variant" }
                } %>
            </div>
        </div>

        <%= render "game/pairing_spinner" %>

        <div class="mt-3 text-center">
	        <%= link_to t(:play), "", class: "w-50 btn btn-outline-success custom-font-size", 
                data: { action: "click->pairing#recruit", turbo: false } %> 
        </div>
    </div>
</div>
