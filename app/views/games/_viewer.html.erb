<% orientation = game.orientation(current_user) %>
<% opponent = game.opponent(current_user) %>

<%= content_tag :div, "", data: {
	controller: "viewer",
	game_id: game.id,
    mode: game.mode,
	turn: game.turn,
    player_id: current_user&.id, 
	fen: game.fen,
    pgn: game.pgn,
	white_timer: game.white_timer,
    black_timer: game.black_timer,
	increment: game.time_increment,
    updated_at: game.updated_at.to_f,
	orientation: orientation,
    piece_theme: pieceTheme(@piece_theme),
	board_theme: @board_theme
} do %>

	<div class="col-8 d-flex justify-content-center">
		<div style="width: 400px">
			<%= render "game/player_card", id: 2, card: playerCard(opponent, orientation == "white" ? game.black_timer : game.white_timer) %>
			<div class="position-relative">
    			<div id="board" style="width: 400px"></div>
				<%= render "game/promote_to" %>
			</div>
    		<%= render "game/player_card", id: 1, card: playerCard(current_user, orientation == "white" ? game.white_timer : game.black_timer) %>

			<%= render "game/navigator", controller: "viewer", pause: false %>
    	</div>
	</div>

	<div class="col-4 p-5">
    	<div class="my-3">
      		<h2><%= t(:annotation) %></h2>
    		<p data-viewer-target="annotation"></p>
		</div>
    	<%= content_tag(:div, "", data: {viewer_target: "state"}, class: "my-3") do %>
    		<h2><%= t(:state) %></h2>
    		<%= game.state %>
    	<% end %>
    	<%= content_tag(:div, "", data: {viewer_target: "fen"}, class: "my-3") do %>
    		<h2>FEN</h2>
    		<%= game.fen %>
    	<% end %>
    	<%= turbo_frame_tag dom_id(game, "pgn") do %>
    		<h2>PGN</h2>
    		<div>
    			<pre class="pgn" id="<%= dom_id(game, "pre_pgn") %>"><%= game.pgn %></pre>
    		</div>
    	<% end %>
  	</div>
<% end %>
