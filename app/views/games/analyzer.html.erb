<%= content_tag :div, id: "analyzer", data: {
    controller: "analyzer",
    board_theme: @board_theme,
    piece_theme: pieceTheme(@piece_theme)
} do %>

	<h3 class="text-center"><%= t(:analyzer) %></h3>

    <div class="row py-5">
        <div class="col-md-8 order-md-2 text-center">
            <%#= render "games/player_card", card: orientation === "white" ? SetCard(game, "black") : SetCard(game, "white") %>
            <div id="board" class="mx-auto" style="width: 100%; max-width: 600px;"></div>
            <%#= render "games/player_card", card: orientation === "white" ? SetCard(game, "white") : SetCard(game, "black") %>
            
            <div class="my-2">
                <button class="btn btn-primary" data-action="analyzer#startBtn">
                    <i class="bi bi-chevron-bar-left"></i>  
                </button>
                <button class="btn btn-primary" data-action="analyzer#prevBtn">
                    <i class="bi bi-chevron-left"></i>  
                </button>
                <button class="btn btn-primary" data-action="analyzer#nextBtn">
                    <i class="bi bi-chevron-right"></i> 
                </button>
                <button class="btn btn-primary" data-action="analyzer#endBtn">
                    <i class="bi bi-chevron-bar-right"></i>  
                </button>
            </div>
            <div class="my-3">
                <h5><%= t(:annotation) %></h5>
                <p data-analyzer-target="annotation"></p>
            </div>
            <%= render "game/promotion" %>
        </div>

        <div class="col-md-2 order-md-1">
            <div class="w-100 ms-4">
                <div class="row my-2">
                    <label for="timeBase" class="col-sm-8 col-form-label">Base time (min)</label>
                    <div class="col-sm-4">
                        <input type="number" class="form-control" id="timeBase" value="5">
                    </div>
                </div>
                <div class="row my-2">
                    <label for="timeInc" class="col-sm-8 col-form-label">Increment (sec)</label>
                    <div class="col-sm-4">
                        <input type="number" class="form-control" id="timeInc" value="2">
                    </div>
                </div>
                <div class="row my-2">
                    <label for="skillLevel" class="col-sm-8 col-form-label">Skill Level (0-20)</label>
                    <div class="col-sm-4">
                        <input type="number" class="form-control" id="skillLevel" value="0">
                    </div>
                </div>
                <div class="my-2">
                    <legend class="col-form-label col-sm-2">I play</legend>
                    <div class="d-inline-block">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="color" id="color-white" checked>
                            <label class="form-check-label" for="color-white">White</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="color" id="color-black">
                            <label class="form-check-label" for="color-black">Black</label>
                        </div>
                    </div>
                </div>
                <div class="form-check form-switch my-2">
                    <input class="form-check-input" type="checkbox" id="show-score" checked>
                    <label for="show-score" class="form-label">Show score</label>
                </div>
                <div class="form-check form-switch my-2">
                    <input class="form-check-input" type="checkbox" id="queen-promotion">
                    <label for="queen-promotion" class="form-label">Authomatic promotion to Queen</label>
                </div>

                <h5>Evaluation</h5>
                <pre id=evaluation></pre>
                
                <button class="btn btn-primary w-50 my-2" data-action="analyzer#flipBtn">
                    <%= t(:flip_board) %>
                </button>
                <div class="my-2">
                    <h5><%= t(:header) %></h5>
                    <p data-analyzer-target="header" class="text-start ms-5"></p>
                </div>
            </div>
        </div>

        <div class="col-md-2 order-md-3">
            <div class="w-100 pe-4">
                <div class="my-3" data-analyzer-target="fen">
                    <h2><%= t(:fen) %></h2>
                    <textarea id="fen-load" rows=2 class="w-100 my-3" placeholder="<%= t(:fen_load) %>" autocomplete="off" data-action="analyzer#fenLoad"></textarea>  
                </div>

                <div class="my-3" data-analyzer-target="pgn">
                    <h2><%= t(:pgn) %></h2>
                    <div>
                        <textarea id="pgn-load" rows=10 class="w-100 my-3" placeholder="<%= t(:pgn_paste) %>" autocomplete="off" data-action="analyzer#pgnLoad"></textarea>
                        <label for="pgn-upload" class="btn btn-primary w-25 my-3">
                            <span><%= t(:pgn_upload) %></span>
                            <input id="pgn-upload" type="file" class="d-none" data-action="analyzer#pgnUpload"/>
                        </label>
                    </div>
                </div>
            </div>
        </div>

    </div>
<% end %>
