<div id="vs-bot" class="row m-5">
    <div class="col-md-7 d-flex justify-content-center" do>
        <%= render "vsbot", game: @game, controller: "engine" %>

		<div class="my-3">
    		<h5><%= t(:state) %></h5>
    		<p data-engine-target="state"><%= @game.state %></p>
  		</div>
		<div class="my-3">
    		<h5>FEN</h5>
    		<p data-engine-target="fen"><%= @game.fen %></p>
		</div>
    	<div class="my-3">
			<h5><%= t(:pgn) %></h5>
			<pre id="pgn"></pre>
		</div>
	</div>
    <div class="col-md-5 mt-5">
        <%= render "game/vsbot_buttons" %> 
    </div>
</div>
