<%= turbo_frame_tag "appearance_channel" %>
<div id="appearance_channel"></div>
<%= audio_tag "discord.mp3", id: 'audio-tag' %>
<%= turbo_frame_tag "message_error" do %>
    <%= render 'shared/message_error' %>
<% end %>

<div id="chatroom_container" class="row bg-dark text-light">
    <div id="side_panel" class="col-md-4 col-sm-4 text-bg-<%= @theme %>">
        <div class="my-4">
            <h5><%= t(:users) %></h5>
            <%= turbo_stream_from "users" %>
            <div id="users" data-controller="user-list">
                <%= render "users/users", users: @users %>
            </div>
        </div>

        <div class="my-4">
            <h5><%= t(:rooms) %></h5>
            <%= turbo_stream_from "rooms" %>
            <%= render 'room/new_room_form' %>
            <%= render 'rooms/search_form' %>
            <div id="rooms" data-controller="room-list">
                <%= render "rooms/rooms", rooms: @joined_rooms, user: current_user %>
            </div>
        </div>
    </div>

    <div id="room_container" class="col-md-8 col-sm-8 text-bg-<%= @theme %>">
        <% if @single_room %>
            <div id="single_room" class="d-flex flex-column">
                <h4 class="text-center">
                    <%= @user&.username || @single_room.name %>
                    <%= link_to call_user_path(user: @user), target: "_blank", class: "your_class" do %>
                        <i class="bi bi-camera-video-fill"></i>
                    <% end %>
                </h4>
                <%= turbo_stream_from @single_room %>
                <div id="messages" class="flex-grow-1" data-controller="scroll">
                    <%= turbo_frame_tag "page_handler" %>
                    <%= render "messages/pager", pagy: @pagy %>
                    <div id="messages-container">
                        <%= render @messages %>
                    </div>
                </div>
                <%= render 'message/new_message_form' %>
            </div>
        <% end %>
    </div>
</div>
