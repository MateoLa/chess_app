<div class="w-100 my-2 d-flex align-items-center">
    <div class="icon-container">
        <%= link_to image_tag(user.avatar.variant(:micro), class: 'chat_pfp'), new_user_session_path %>
        <%= render "users/status", user: user %>
    </div>
    <div class="w-100 d-flex">
        <%= link_to user.username, new_user_session_path, class:"w-100 mx-2 username link-body-emphasis", data: {turbo: "false"} %>
        <%= link_to "\u{2694}", new_user_session_path, class: "ms-auto" %>
    </div>
</div>
