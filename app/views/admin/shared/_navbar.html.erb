          <a class="nav-link disabled" href="#" tabindex="-1" aria-disabled="true">Disabled</a>
        </li>
        <li class="nav-item">
          <%= link_to t(:profile), edit_user_registration_path, class: 'nav-link' if current_user %>
        </li>
      </ul>
