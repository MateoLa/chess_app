      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <%= link_to t(:dashboard), admin_path, class: "nav-link active" %>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#">Link</a>
        </li>
        <li class="nav-item">
          <%= link_to t(:see), settings_path, class: 'nav-link' %>
        </li>
        <li class="nav-item">
          <%= link_to t(:settings), settings_path, class: 'nav-link' %>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link custom-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <%= t(:settings) %>
