          <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
            <li><%= link_to t(:appearance), "#", class: "dropdown-item disabled" %></li>
            <li><%= link_to t(:light_theme), set_theme_path(theme: 'light'), class: 'dropdown-item' %></li>
            <li><%= link_to t(:dark_theme), set_theme_path(theme: 'dark'), class: 'dropdown-item' %></li>
            <li><%= link_to t(:system_default), set_theme_path, class: 'dropdown-item' %></li>
            <li><hr class="dropdown-divider"></li>
            <li><%= link_to t(:language), "#", class: "dropdown-item disabled" %></li>
            <li><%= link_to t(:spanish), set_locale_path(locale: 'es'), class: 'dropdown-item' %></li>
            <li><%= link_to t(:english), set_locale_path(locale: 'en'), class: 'dropdown-item' %></li>
          </ul>
        </li>
