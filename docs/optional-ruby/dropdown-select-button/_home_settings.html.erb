<div id="game-settings" class="w-100 custom-font-size bg-<%= @theme %> my-5 p-3">
    <div class="d-flex align-items-center my-2">
        <% if current_user %>
            <%= image_tag(current_user.avatar.variant(:micro), class: "rounded-circle") %>
            <div class="ms-3"><%= current_user.username %></div>
        <% else %>
            <%= image_tag("png/question-mark.png", class: "rounded-circle", width: 18, height: 18) %>
            <div class="ms-3"><%= t(:anonymous) %></div>
        <% end %>
    </div>

    <div class="my-2 row">
        <div class="col-12 col-md-3 align-self-center">
            <span><%= t(:mode) %></span>
        </div>
        <div class="col-12 col-md-9">
            <%= render "shared/dropdown_select",
                preference: "mode",
                selected: @mode,
                options: game_mode_select_options
            %>
        </div>
    </div>

    <div class="my-2 row">
        <div class="col-12 col-md-3 align-self-center">
            <span><%= t(:speed) %></span>
        </div>
        <div class="col-12 col-md-9">
            <%= render "shared/dropdown_select",
                preference: "variant",
                selected: @variant.name,
                options: variant_select_options
            %>
        </div>
    </div>

    <div class="my-2 row">
        <div class="col-12 col-md-3 align-self-center">
            <span><%= t(:level) %></span>
        </div>
        <div class="col-12 col-md-9">
            <%= render "shared/dropdown_select", 
                preference: "level",
                selected: @level,
                options: game_level_select_options
            %>
        </div>
    </div>

    <div class="my-2 row">
        <div class="col-12 col-md-3 align-self-center">
            <span><%= t(:color) %></span>
        </div>
        <div class="col-12 col-md-9" data-controller="dpdwsel" data-pref="color">
            <label class="p-1 m-0 me-2">
                <%= radio_button_tag :color, "white",  data: {action: "dpdwsel#changed"}, checked: true %>
                <%= t(:white) %>
            </label>
            <div class="form-check-inline p-1 m-0">
                <%= radio_button_tag :color, "black", data: {action: "dpdwsel#changed"} %>
                <span><%= t(:black) %></span>
            </div>
        </div>
    </div>
</div>

